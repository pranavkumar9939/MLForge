# Copy this file to .env and adjust values for your environment.
# All of these have sensible defaults in app/core/config.py - you only
# need to set the ones you want to override.

ENVIRONMENT=development

# --- Security -----------------------------------------------------------
# REQUIRED in production. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=dev-only-insecure-secret-change-me-in-production

# --- CORS -----------------------------------------------------------------
# Comma-separated list is not supported directly by pydantic-settings for
# List[str] fields via env vars in this config - set via a .env file using
# JSON array syntax instead, e.g.:
# CORS_ORIGINS=["https://app.example.com"]

# --- Storage --------------------------------------------------------------
# UPLOAD_DIR=./uploads
# SAVED_MODELS_DIR=./saved_models
# DATABASE_URL=sqlite:///./mlforge.db

# --- Upload limits ----------------------------------------------------------
# MAX_UPLOAD_SIZE_MB=200



